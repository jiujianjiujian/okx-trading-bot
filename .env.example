# ============================================
# Bybit 交易所 API 配置
# 去 https://www.bybit.com/app/user/api-management 创建
# 建议先用测试网: https://testnet.bybit.com
# ============================================
BYBIT_API_KEY=你的api_key
BYBIT_SECRET_KEY=你的secret_key
# 测试网设为 true，实盘设为 false
BYBIT_DEMO=true

# ============================================
# 3Commas DCA Bot 信号配置
# 在 3Commas Bot → Signals → Create Signal 获取
# Webhook URL + JWT Secret + Bot UUID
# ============================================
# 3Commas 提供的 Webhook 地址
THREECOMMAS_WEBHOOK_URL=https://api.3commas.io/signals/v1/your_webhook_path
# JWT Secret (从 3Commas Signal 设置页复制)
THREECOMMAS_SECRET=eyJhbGciOiJIUzI1NiJ9...
# Bot UUID (从 3Commas Signal 设置页复制)
THREECOMMAS_BOT_UUID=864338c2-08a4-4001-9889-b26ca712e2bd
# 交易所名称 (Bybit / BybitTestnet)
THREECOMMAS_EXCHANGE=Bybit

# ============================================
# 剥头皮参数
# ============================================
# 每日目标净利润 USDT（扣手续费后）
DAILY_TARGET_USDT=50.0
# 单笔最大亏损 USDT
MAX_LOSS_PER_TRADE_USDT=5.0
# 每日最大亏损 USDT（超过暂停）
MAX_DAILY_LOSS_USDT=30.0
# 每日最大交易次数
MAX_DAILY_TRADES=20

# 剥头皮止损止盈范围（%）
SCALP_SL_PCT_MIN=0.15
SCALP_SL_PCT_MAX=0.50
SCALP_TP_PCT_MIN=0.30
SCALP_TP_PCT_MAX=1.50

# 最低净盈亏比（扣费后）
MIN_NET_RR=2.0

# 手续费估计（Bybit 合约 taker 0.055%）
FEE_TAKER_PCT=0.055
FEE_MAKER_PCT=0.020
ESTIMATED_FEE_PCT=0.11

# AI 决策最低置信度（低于此值不交易）
MIN_AI_CONFIDENCE=65

# 最大并发持仓数
MAX_POSITIONS=3

# ============================================
# TradingView Webhook
# ============================================
WEBHOOK_PORT=8000
WEBHOOK_SECRET=设一个密码
ADMIN_API_TOKEN=设一个后台密码

# ============================================
# Telegram 通知
# ============================================
TELEGRAM_BOT_TOKEN=你的bot_token
TELEGRAM_CHAT_ID=你的chat_id
TELEGRAM_ENABLED=true
# TELEGRAM_PROXY=socks5://127.0.0.1:7890

# ============================================
# DeepSeek AI 配置
# https://platform.deepseek.com
# ============================================
DEEPSEEK_API_KEY=你的api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048

# ============================================
# 交易品种（逗号分隔）
# ============================================
SCALP_UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,DOGEUSDT,SUIUSDT

# ============================================
# 代理 (本地开发需要)
# ============================================
# PROXY_URL=http://127.0.0.1:7890

# ============================================
# 数据库 & AI 自主启动
# ============================================
DB_PATH=trades.db
AI_AUTO_START=false
