# ============================================
# OKX 交易所 API 配置
# 去 https://www.okx.com/account/my-api 创建
# 小白建议先用模拟盘: https://www.okx.com/zh-hans/demo-trading
# ============================================
OKX_API_KEY=你的api_key
OKX_SECRET_KEY=你的secret_key
OKX_PASSPHRASE=你的passphrase
# 模拟盘设为 true，实盘设为 false
OKX_DEMO=true

# ============================================
# Telegram 机器人配置
# 去找 @BotFather 创建机器人获取 Token
# 去找 @userinfobot 获取你的 Chat ID
# ============================================
TELEGRAM_BOT_TOKEN=你的bot_token
TELEGRAM_CHAT_ID=你的chat_id
# 本地开发若 VPS 已在运行同一个 Token，设为 false 避免 getUpdates 冲突
TELEGRAM_ENABLED=true
# 可选代理，例如 socks5://127.0.0.1:7890
# TELEGRAM_PROXY=
# PROXY_URL=

# ============================================
# 交易风控参数
# ============================================
# 单笔风险占账户比例（%）
RISK_PER_TRADE=2.0
# 默认杠杆倍数
DEFAULT_LEVERAGE=10
# 自主交易杠杆区间，仓位仍按止损风险计算
MIN_LEVERAGE=10
MAX_LEVERAGE=25
# 最大同时持仓数
MAX_POSITIONS=3
# 每日最大亏损比例（%），超过后停止交易
MAX_DAILY_LOSS=5.0
# 是否自动下单（false=只通知不下单，适合先观察）
AUTO_TRADE=false
# 交易池：core=只扫 BTC/ETH/SOL 等主流币；dynamic=全市场筛选
TRADING_UNIVERSE=core
# 净盈亏比成本估计：单边手续费、单边滑点、扣成本后最低盈亏比
ESTIMATED_FEE_RATE=0.0005
ESTIMATED_SLIPPAGE_RATE=0.0002
MIN_NET_RR=3.0
# 单币冷却保护
SYMBOL_COOLDOWN_MINUTES=120
SYMBOL_MAX_DAILY_LOSSES=2
# 市场图谱共振闸门：低优势、高冲突、低流动性时跳过
MARKET_GRAPH_ENABLED=true
MARKET_GRAPH_MIN_EDGE=60
MARKET_GRAPH_MAX_CONFLICT=35
MARKET_GRAPH_MIN_LIQUIDITY=55
# 分数凯利仓位：用历史胜率校准 AI 置信度，只影响仓位大小
KELLY_FRACTION=0.25
KELLY_PRIOR_WIN_RATE=0.45
KELLY_PRIOR_TRADES=20
KELLY_NO_HISTORY_CONF_CAP=0.52
KELLY_MIN_EDGE_PCT=2.0
KELLY_MAX_RISK_PCT=0.75
# 账户/仓位有效性：余额不足、名义价值太小、保证金占用过高时不下单
MIN_EFFECTIVE_NOTIONAL=20
MIN_AVAILABLE_BALANCE=10
MAX_TRADE_MARGIN_USAGE_PCT=30

# ============================================
# Webhook 服务配置
# ============================================
# Webhook 监听端口
WEBHOOK_PORT=8000
# Webhook 密钥（在 TV 警报中设置，防止未授权访问）
WEBHOOK_SECRET=自己设一个密码
# 后台 API / 仪表盘访问密钥；不填时默认复用 WEBHOOK_SECRET
ADMIN_API_TOKEN=自己再设一个后台密码

# ============================================
# DeepSeek AI 复盘配置
# 去 https://platform.deepseek.com 注册获取 API Key
# ============================================
DEEPSEEK_API_KEY=你的deepseek_api_key

# ============================================
# QQ Bot (NapCatQQ OneBot v11)
# 需要安装 NapCatQQ 并配置反向 WebSocket
# ============================================
QQ_BOT_ENABLED=true
QQ_WS_PORT=8080
QQ_ADMIN_IDS=你的QQ号
# QQ_GROUP_ID=你的群号

# ============================================
# Anthropic Claude API (自由对话)
# 去 https://console.anthropic.com 获取 API Key
# ============================================
ANTHROPIC_API_KEY=你的claude_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024

# ============================================
# 会话管理
# ============================================
MAX_CONVERSATION_HISTORY=20
